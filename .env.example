# Site-wide password gate (netlify/edge-functions/site-gate.js). One shared
# password for every path, present and future, including static assets and /api/*.
# SECRET - server only, never prefix with VITE_. On Netlify set it in the
# dashboard with a scope that includes Functions, or the edge gate cannot read it.
# Leave it unset to keep the whole site open. Prefer a long passphrase: the gate
# does not throttle guesses.
SITE_PASSWORD=

# Optional: get a Discord ping when she picks "Permission Granted" or "Send HD First".
# Copy this file to ".env" and paste the webhook URL below.
# On Netlify, make it available to Functions or all scopes; on Vercel, add it as
# a server-side environment variable. Never prefix this key with VITE_ -- that would expose it
# in the browser bundle. Leave it unset to disable notifications safely.
DISCORD_WEBHOOK_URL=

# Mission 143 unlock gate. Server-side only - never prefix any of these with VITE_.
# Copy this file to ".env" for local dev; on Netlify/Vercel, set them as
# server-side environment variables.

# Comma-separated accepted nickname aliases, checked server-side only (matched
# with NFKC normalization, case and whitespace insensitive). The gate never
# reveals these values back to the client.
MISSION_ALIASES=

# Display names released to the client only after the gate passes.
MISSION_NAME_A=
MISSION_NAME_S=

# Comma-separated accepted answers for the two typed in-game questions, also
# released to the client only after the gate passes.
MISSION_ALIASES_A=
MISSION_ALIASES_S=

# Supabase project used to mint short-lived signed URLs for the private photo/meme assets.
SUPABASE_URL=https://example.supabase.co
SUPABASE_BUCKET=mission-143
# SECRET - server only. Set this in the hosting dashboard (Netlify/Vercel).
# Never commit a real value and never reference it from anything under apps/.
SUPABASE_SERVICE_ROLE_KEY=

# JSON describing the 8 private media items (4 photo + 4 meme), each { path, alt }.
# "path" is the object key inside SUPABASE_BUCKET; "alt" is safe to ship as-is.
MISSION_MEDIA={"photo":[{"path":"photo-1.jpg","alt":"placeholder"},{"path":"photo-2.jpg","alt":"placeholder"},{"path":"photo-3.jpg","alt":"placeholder"},{"path":"photo-4.jpg","alt":"placeholder"}],"meme":[{"path":"meme-1.jpg","alt":"placeholder"},{"path":"meme-2.jpg","alt":"placeholder"},{"path":"meme-3.jpg","alt":"placeholder"},{"path":"meme-4.jpg","alt":"placeholder"}]}
